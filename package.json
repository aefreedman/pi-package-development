{
  "name": "@aefree/pi-package-development",
  "version": "0.5.2",
  "description": "Methods, architecture guidance, and workflows for developing Pi packages.",
  "type": "module",
  "sideEffects": [
    "./extensions/index.ts"
  ],
  "license": "MIT",
  "keywords": [
    "pi-package",
    "package-development",
    "architecture",
    "agent-skills",
    "evals"
  ],
  "files": [
    "dist",
    "extensions",
    "references",
    "skills",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs tests/skill-evals/*.test.ts",
    "eval:audit": "node --experimental-strip-types evals/auditing-pi-packages/run-eval.ts",
    "eval:release": "node --experimental-strip-types evals/preparing-pi-package-releases/run-eval.ts",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aefree/pi-capability-registry": "^0.1.0",
    "@aefree/pi-package-references": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aefreedman/pi-package-development.git"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-package-development/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-package-development#readme"
}
